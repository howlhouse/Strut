rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The hardcoded owner account is always an admin; anyone else gets admin
    // access only if the owner has granted it (a doc in /admins).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'howlhousemedia@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Multi-tenant: any signed-in Google account may use the app, but each
    // user's data lives under their own uid and only that same uid may ever
    // read or write it. No user — including an admin — can see or affect
    // another user's financial data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Presence of /admins/{uid} grants that uid admin access. Only the
    // hardcoded owner may grant or revoke it, to prevent an admin from
    // escalating anyone (including themselves further) on their own.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.token.email == 'howlhousemedia@gmail.com';
    }

    // Lightweight account info (email, display name, timestamps) — no
    // financial data. Self-written on sign-in; readable by the owning user
    // or any admin, for the Admin Console's user list.
    match /userProfiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Community events calendar -------------------------------------
    // Promoters (any signed-in user) submit listings; an admin reviews and
    // publishes them. Fields that carry the business side of a listing —
    // status, fee, featured, owner — are admin-controlled: a non-admin can
    // create only a pending/unpaid/unfeatured listing, and can never change
    // those fields afterwards (other than resubmitting a declined listing,
    // which moves it back to pending).

    // Links must be plain http(s) (or empty), so a promoter can't plant a
    // javascript: URL that other members would click.
    function okUrl(d, f) {
      return !(f in d) || d[f] == '' ||
        (d[f] is string && d[f].size() <= 2048 && d[f].matches('^https?://.*'));
    }
    function validEvent() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.date is string && d.date.size() == 10
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && okUrl(d, 'imageUrl') && okUrl(d, 'ticketUrl') && okUrl(d, 'websiteUrl');
    }
    function ownerEditOk() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerUid == request.auth.uid
        && after.ownerUid == before.ownerUid
        && after.get('featured', false) == before.get('featured', false)
        && after.get('feePaid', false) == before.get('feePaid', false)
        && after.get('feeAmount', 0) == before.get('feeAmount', 0)
        && (after.status == before.status || (before.status == 'declined' && after.status == 'pending'));
    }

    match /communityEvents/{eventId} {
      // Live listings are visible to every signed-in user; drafts and
      // declined ones only to their owner and admins.
      allow read: if request.auth != null && (
        resource.data.status == 'published' ||
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        isAdmin() || (
          request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.get('featured', false) == false
          && request.resource.data.get('feePaid', false) == false
          && validEvent()
        )
      );
      allow update: if request.auth != null && (isAdmin() || (ownerEditOk() && validEvent()));
      allow delete: if request.auth != null && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // Shared tag/category catalog used by every account. Any signed-in user
    // can read it (to tag their own bills); only an admin can change it.
    match /catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
